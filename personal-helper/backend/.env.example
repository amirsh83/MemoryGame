# ── App ──────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-long-random-secret-32-chars-minimum
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/personal_helper.db
# Fernet key for encrypting sensitive fields (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# ── Google OAuth2 ─────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Anthropic (Claude) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Telegram ─────────────────────────────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Secret token to verify webhook requests (any random string)
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Your public URL for receiving Telegram webhooks
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# ── JWT ──────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
